{
  "name": "plonk-ui",
  "version": "1.0.0",
  "description": "Neo-brutalist React components with switchable personalities.",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "neo-brutalism",
    "tailwindcss",
    "react-aria",
    "accessibility",
    "animation",
    "themes"
  ],
  "license": "MIT",
  "homepage": "https://plonk-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melihfidandev/plonk-ui.git",
    "directory": "packages/plonk"
  },
  "bugs": {
    "url": "https://github.com/melihfidandev/plonk-ui/issues"
  },
  "author": "Melih Fidan",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./theme.css": "./dist/theme.css",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tokens": "tsx scripts/generate-tokens.ts",
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.23",
    "clsx": "^2.1.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
